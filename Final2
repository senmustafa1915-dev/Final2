          cat > app/src/main/java/com/securelock/guard/LockAccessibilityService.kt <<'EOF'
          package com.securelock.guard

          import android.accessibilityservice.AccessibilityService
          import android.graphics.Color
          import android.graphics.PixelFormat
          import android.graphics.Typeface
          import android.os.Handler
          import android.os.Looper
          import android.provider.Settings
          import android.text.Editable
          import android.text.InputType
          import android.text.TextWatcher
          import android.view.Gravity
          import android.view.WindowManager
          import android.view.inputmethod.EditorInfo
          import android.view.accessibility.AccessibilityEvent
          import android.widget.Button
          import android.widget.EditText
          import android.widget.LinearLayout
          import android.widget.TextView
          import java.util.concurrent.Executors

          class LockAccessibilityService : AccessibilityService() {

              private val handler = Handler(Looper.getMainLooper())
              private val executor = Executors.newSingleThreadExecutor()

              private var overlay: android.view.View? = null
              private var overlayPackage: String? = null
              private var overlayStatus: TextView? = null
              private var passwordInput: EditText? = null
              private var checking = false

              private var lastPackage: String? = null
              private var unlockedPackage: String? = null

              private val timerTask = object : Runnable {
                  override fun run() {
                      val pkg = overlayPackage ?: return

                      if (LockStore.isStrictActive(this@LockAccessibilityService, pkg)) {
                          val remaining =
                              LockStore.strictUntil(this@LockAccessibilityService, pkg) -
                              System.currentTimeMillis()

                          overlayStatus?.text =
                              "Katı Mod etkin\nKalan süre: ${formatDuration(remaining)}"

                          if (remaining <= 0L) {
                              removeOverlay()
                          }
                      } else {
                          val prefs = LockStore.prefs(this@LockAccessibilityService)
                          val until = prefs.getLong("lockout:$pkg", 0L)
                          val remaining = until - System.currentTimeMillis()

                          if (remaining > 0L) {
                              overlayStatus?.text =
                                  "Çok fazla yanlış deneme.\nTekrar denemek için ${remaining / 1000 + 1} saniye"

                              passwordInput?.isEnabled = false
                          } else {
                              overlayStatus?.text = "Şifreni gir."
                              passwordInput?.isEnabled = true
                          }
                      }

                      handler.postDelayed(this, 1000)
                  }
              }

              override fun onAccessibilityEvent(event: AccessibilityEvent?) {
                  val pkg = event?.packageName?.toString() ?: return

                  if (isKeyboardPackage(pkg)) return
                  if (pkg == packageName && overlay != null) return

                  if (lastPackage != pkg) {
                      if (unlockedPackage != null && unlockedPackage != pkg) {
                          unlockedPackage = null
                      }
                      lastPackage = pkg
                  }

                  if (pkg == packageName || pkg == "com.android.systemui") {
                      if (overlayPackage != null && pkg != packageName) {
                          removeOverlay()
                      }
                      return
                  }

                  if (!LockStore.isLockedNow(this, pkg)) {
                      if (overlayPackage != null && overlayPackage != pkg) {
                          removeOverlay()
                      }
                      return
                  }

                  if (unlockedPackage == pkg) return

                  showLockScreen(pkg)
              }

              private fun isKeyboardPackage(pkg: String): Boolean {
                  val ime = Settings.Secure.getString(
                      contentResolver,
                      Settings.Secure.DEFAULT_INPUT_METHOD
                  )

                  return !ime.isNullOrBlank() &&
                      ime.substringBefore("/") == pkg
              }

              private fun showLockScreen(pkg: String) {
                  if (overlay != null && overlayPackage == pkg) return

                  removeOverlay()
                  overlayPackage = pkg
                  checking = false

                  val strict = LockStore.isStrictActive(this, pkg)
                  val key = LockStore.passwordKeyFor(this, pkg)

                  val expectedLength = LockStore.secretLength(this, key)

                  val root = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      gravity = Gravity.CENTER
                      setPadding(dp(32), dp(32), dp(32), dp(32))
                      setBackgroundColor(Color.BLACK)
                  }

                  val title = TextView(this).apply {
                      text = "SECURE LOCK"
                      textSize = 25f
                      setTextColor(Color.WHITE)
                      typeface = Typeface.DEFAULT_BOLD
                      gravity = Gravity.CENTER
                  }

                  root.addView(title)

                  val status = TextView(this).apply {
                      textSize = 16f
                      setTextColor(Color.LTGRAY)
                      gravity = Gravity.CENTER
                      setPadding(0, dp(24), 0, dp(24))
                  }

                  overlayStatus = status
                  root.addView(status)

                  if (strict) {
                      status.text = "Katı Mod etkin"
                  } else {
                      val input = EditText(this).apply {
                          hint = "Şifre"
                          setSingleLine(true)
                          inputType =
                              InputType.TYPE_CLASS_TEXT or
                              InputType.TYPE_TEXT_VARIATION_PASSWORD
                          imeOptions = EditorInfo.IME_ACTION_DONE
                          setTextColor(Color.WHITE)
                          setHintTextColor(Color.GRAY)
                          setPadding(dp(16), dp(12), dp(16), dp(12))
                          setBackgroundColor(Color.rgb(34, 34, 34))
                      }

                      passwordInput = input

                      root.addView(
                          input,
                          LinearLayout.LayoutParams(
                              LinearLayout.LayoutParams.MATCH_PARENT,
                              dp(54)
                          )
                      )

                      input.addTextChangedListener(object : TextWatcher {
                          override fun beforeTextChanged(
                              s: CharSequence?,
                              start: Int,
                              count: Int,
                              after: Int
                          ) {}

                          override fun onTextChanged(
                              s: CharSequence?,
                              start: Int,
                              before: Int,
                              count: Int
                          ) {
                              val value = s?.toString().orEmpty()

                              if (
                                  !checking &&
                                  expectedLength >= 6 &&
                                  value.length == expectedLength
                              ) {
                                  verifyPassword(pkg, key, value)
                              }
                          }

                          override fun afterTextChanged(s: Editable?) {}
                      })

                      input.setOnEditorActionListener { _, actionId, _ ->
                          if (actionId == EditorInfo.IME_ACTION_DONE) {
                              val value = input.text.toString()

                              if (!checking && value.isNotEmpty()) {
                                  verifyPassword(pkg, key, value)
                              }

                              true
                          } else {
                              false
                          }
                      }

                      val breakRow = LinearLayout(this).apply {
                          orientation = LinearLayout.HORIZONTAL
                          gravity = Gravity.CENTER
                          setPadding(0, dp(18), 0, 0)
                      }

                      val five = Button(this).apply {
                          text = "5 Dakika Mola"
                          setOnClickListener { grantBreak(pkg, 5) }
                      }

                      val ten = Button(this).apply {
                          text = "10 Dakika Mola"
                          setOnClickListener { grantBreak(pkg, 10) }
                      }

                      breakRow.addView(
                          five,
                          LinearLayout.LayoutParams(0, dp(48), 1f)
                      )

                      breakRow.addView(
                          ten,
                          LinearLayout.LayoutParams(0, dp(48), 1f)
                      )

                      root.addView(breakRow)
                  }

                  val params = WindowManager.LayoutParams(
                      WindowManager.LayoutParams.MATCH_PARENT,
                      WindowManager.LayoutParams.MATCH_PARENT,
                      WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
                      WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                          WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                      PixelFormat.TRANSLUCENT
                  ).apply {
                      gravity = Gravity.TOP or Gravity.START
                      softInputMode =
                          WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE
                  }

                  try {
                      getSystemService(WindowManager::class.java)
                          .addView(root, params)

                      overlay = root

                      handler.removeCallbacks(timerTask)
                      handler.post(timerTask)
                  } catch (_: Exception) {
                      overlay = null
                      overlayPackage = null
                  }
              }

              private fun verifyPassword(
                  pkg: String,
                  key: String,
                  value: String
              ) {
                  if (checking) return

                  val prefs = LockStore.prefs(this)
                  val lockedUntil = prefs.getLong("lockout:$pkg", 0L)

                  if (lockedUntil > System.currentTimeMillis()) {
                      passwordInput?.isEnabled = false
                      return
                  }

                  checking = true

                  executor.execute {
                      val valid = LockStore.verifySecret(this, key, value)

                      handler.post {
                          if (overlayPackage != pkg) {
                              checking = false
                              return@post
                          }

                          checking = false

                          if (valid) {
                              prefs.edit()
                                  .remove("wrong:$pkg")
                                  .remove("lockout:$pkg")
                                  .apply()

                              unlockedPackage = pkg
                              removeOverlay()
                          } else {
                              recordWrongAttempt(pkg)
                              passwordInput?.setText("")
                              updateLockoutMessage(pkg)
                          }
                      }
                  }
              }

              private fun recordWrongAttempt(pkg: String) {
                  val prefs = LockStore.prefs(this)
                  val count = prefs.getInt("wrong:$pkg", 0) + 1

                  val delaySeconds = when (count) {
                      3 -> 10L
                      4 -> 30L
                      5 -> 60L
                      6 -> 120L
                      7 -> 300L
                      8 -> 600L
                      9 -> 1800L
                      else -> if (count >= 10) 3600L else 0L
                  }

                  val editor = prefs.edit().putInt("wrong:$pkg", count)

                  if (delaySeconds > 0L) {
                      editor.putLong(
                          "lockout:$pkg",
                          System.currentTimeMillis() + delaySeconds * 1000L
                      )
                  }

                  editor.apply()
              }

              private fun updateLockoutMessage(pkg: String) {
                  val until = LockStore.prefs(this)
                      .getLong("lockout:$pkg", 0L)

                  val remaining = until - System.currentTimeMillis()

                  if (remaining > 0L) {
                      overlayStatus?.text =
                          "Yanlış şifre.\nTekrar denemek için ${remaining / 1000 + 1} saniye"

                      passwordInput?.isEnabled = false
                  } else {
                      overlayStatus?.text = "Yanlış şifre. Tekrar dene."
                      passwordInput?.isEnabled = true
                  }
              }

              private fun grantBreak(pkg: String, minutes: Int) {
                  if (LockStore.isStrictActive(this, pkg)) return

                  LockStore.prefs(this).edit()
                      .putLong(
                          "grace:$pkg",
                          System.currentTimeMillis() + minutes * 60_000L
                      )
                      .apply()

                  unlockedPackage = null
                  removeOverlay()
              }

              private fun removeOverlay() {
                  handler.removeCallbacks(timerTask)

                  val old = overlay

                  if (old != null) {
                      try {
                          getSystemService(WindowManager::class.java)
                              .removeView(old)
                      } catch (_: Exception) {
                      }
                  }

                  overlay = null
                  overlayPackage = null
                  overlayStatus = null
                  passwordInput = null
                  checking = false
              }

              private fun formatDuration(milliseconds: Long): String {
                  val total = milliseconds.coerceAtLeast(0L) / 1000L
                  val days = total / 86400
                  val hours = (total % 86400) / 3600
                  val minutes = (total % 3600) / 60
                  val seconds = total % 60

                  return if (days > 0) {
                      "${days}g ${hours}s ${minutes}d"
                  } else {
                      String.format("%02d:%02d:%02d", hours, minutes, seconds)
                  }
              }

              private fun dp(value: Int): Int =
                  (value * resources.displayMetrics.density).toInt()

              override fun onInterrupt() {
                  removeOverlay()
              }

              override fun onDestroy() {
                  removeOverlay()
                  executor.shutdownNow()
                  super.onDestroy()
              }
          }
